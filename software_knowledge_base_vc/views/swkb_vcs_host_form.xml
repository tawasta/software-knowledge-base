<?xml version="1.0" encoding="UTF-8"?>
<openerp>
	<data>

		<record id="vcs_host_form_view" model="ir.ui.view">
			<field name="name">vcs_host_form_view_api</field>
			<field name="model">software_knowledge_base.vcs_host</field>
			<field name="inherit_id" ref="software_knowledge_base.vcs_host_form_view" />
			<field name="arch" type="xml">

				<header position="inside">
                    <button name="action_update_repositories"
                        type="object"
                        string="Update repositories"
                        groups="base.group_no_one"
                        attrs="{}"
                    />
					<button name="action_update_repository_readmes"
                        type="object"
                        string="Update readmes"
                        groups="base.group_no_one"
                        attrs="{}"
                    />
                </header>

				<field name="vcs" position="after">
					<field name="vcs_api" />
					<field name="api_token" password="True"/>
					<field name="api_verify_ssl" />
				</field>

			</field>
		</record> 

	</data>
</openerp>