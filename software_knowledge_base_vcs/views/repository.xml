<?xml version="1.0" ?>
<odoo>

    <!-- Repository Tree View -->
    <record model="ir.ui.view" id="repository_tree_view">
        <field name="name">SW Knowledge Base - Repositories tree</field>
        <field name="model">software_knowledge_base.repository</field>
        <field name="arch" type="xml">
            <tree string="Repositories">
                <field name="name"/>
                <field name="url"/>
                <field name="tag_ids"/>
            </tree>
        </field>
    </record>

    <!-- Repository Form View -->
    <record model="ir.ui.view" id="repository_form_view">
        <field name="name">SW Knowledge Base - Repositories form</field>
        <field name="model">software_knowledge_base.repository</field>
        <field name="arch" type="xml">
            <form string="Repositories">
                <header>

                </header>
                <sheet string="Form">
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                required="1"
                                placeholder='Repository name'
                            />
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="vcs" required="1"/>
                            <field name="vcs_host" required="1"/>
                            <field name="vcs_team" required="1"/>
                            <field name="default_branch" required="1"/>
                        </group>

                        <group>
                            <field name="url" required="1" invisible='1'/>
                            <field name="url_readonly" widget='url'/>
                            <field name="active"/>
                            <field name='tag_ids' widget='many2many_tags'/>
                        </group>
                    </group>

                    <separator string="Description"/>
                    <field
                        name="description"
                        nolabel="1"
                        widget="bootstrap_markdown"
                    />

                    <separator string="Readme"/>
                    <field
                        name="readme"
                        nolabel="1"
                        widget="bootstrap_markdown"
                    />

                </sheet>
                <div class="oe_chatter">
                    <field
                        name="message_follower_ids"
                        widget="mail_followers"
                    />
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
