<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Actions -->
    <record id="repositories_action" model="ir.actions.act_window">
        <field name="name">Repositories</field>
        <field name="res_model">software_knowledge_base.repository</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="repository_tags_action" model="ir.actions.act_window">
        <field name="name">Repository tags</field>
        <field name="res_model">software_knowledge_base.repository_tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="vcs_action" model="ir.actions.act_window">
        <field name="name">VCS</field>
        <field name="res_model">software_knowledge_base.vcs</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="vcs_hosts_action" model="ir.actions.act_window">
        <field name="name">VCS Hosts</field>
        <field name="res_model">software_knowledge_base.vcs_host</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="vcs_teams_action" model="ir.actions.act_window">
        <field name="name">VCS Teams</field>
        <field name="res_model">software_knowledge_base.vcs_team</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu hierarchy -->
    <menuitem
        id="vcs_menu"
        name="Version Control"
        parent="software_knowledge_base.root_menu"
        sequence='30'
        groups='software_knowledge_base.developer'
    />

    <menuitem
        id="repositories_menu"
        parent="vcs_menu"
        action="repositories_action"
        sequence='10'
    />
    <menuitem
        id="repository_tags_menu"
        parent="vcs_menu"
        action="repository_tags_action"
        sequence='20'
    />
    <menuitem id="vcs_type_menu" parent="vcs_menu" action="vcs_action" sequence='30' />
    <menuitem
        id="vcs_hosts_menu"
        parent="vcs_menu"
        action="vcs_hosts_action"
        sequence='40'
    />
    <menuitem
        id="vcs_teams_menu"
        parent="vcs_menu"
        action="vcs_teams_action"
        sequence='50'
    />

</odoo>
