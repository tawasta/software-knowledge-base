<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="installation_form_view" model="ir.ui.view">
        <field name="name">installation_form_view_contract</field>
        <field name="model">software_knowledge_base.installation</field>
        <field
      name="inherit_id"
      ref="software_knowledge_base.installation_form_view"
    />
        <field name="arch" type="xml">

            <field name="partner_ids" position="before">
                <group col="4">
                    <field
            name="account_analytic_account_id"
            options="{'no_quick_create':True,'no_create_edit':True}"
          />
                    <field
            name="analytic_account_invoice_line_ids"
            options="{'no_quick_create':True,'no_create_edit':True}"
            domain="[('analytic_account_id', '=', account_analytic_account_id), ('installation_id', '=', False)]"
            widget="many2many_tags"
          />
                </group>
            </field>

        </field>
    </record>
</odoo>
