<?xml version="1.0" ?>
<odoo>
    <!-- Installations Form View -->
    <record model="ir.ui.view" id="installation_form_view">
        <field name="name">installation.form.view</field>
        <field name="model">software_knowledge_base.installation</field>
        <field name="arch" type="xml">
            <form string="Installations">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_modules"
                            icon="fa-puzzle-piece"
                        >
                            <field
                                name="module_count"
                                widget="statinfo"
                                string="Modules"
                            />
                        </button>
                    </div>

                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />

                    <div
                        name="header_group"
                        class="row justify-content-between position-relative w-100 m-0 mb-2"
                    >
                        <div class="oe_title mw-75 ps-0 pe-2 col-8">
                            <h1 class="d-flex flex-row align-items-center">
                                <field name="name" />
                            </h1>
                            <h2>
                                <field name="platform_id" placeholder="Platform..." />
                            </h2>
                        </div>
                        <div class="oe_kanban_avatar col-4">
                            <field
                                name="platform_image"
                                widget="image"
                                class="oe_avatar m-0"
                            />
                        </div>
                    </div>

                    <group name="information_group">
                        <group
                            name="information_group_basic"
                            string="Basic information"
                        >
                            <field name="active" invisible="1" />
                            <field name="identifier" />
                            <field name="company_id" />
                        </group>
                        <group name="information_group_type" string="Installation type">
                            <field name="type" />
                            <field name="url" widget="url" />
                            <field name="admin_url" widget="url" />
                            <field
                                name="server_id"
                                domain="[('server_type', '=', 'application')]"
                            />
                            <field name="server_ip_address" readonly="1" />
                            <field name="port" />
                            <field
                                name="db_server_id"
                                domain="[('server_type', '=', 'database')]"
                            />
                            <field name="db_server_ip_address" readonly="1" />
                        </group>
                    </group>

                    <notebook>
                        <page name="customers" string="Customers">
                            <field name="partner_ids" />
                        </page>
                        <page name="modules" string="Modules">
                            <field name="module_ids" />
                        </page>
                        <page name="usage" string="Usage">
                            <group name="usage_group_users" string="Users">
                                <label
                                    for="user_accounts_active"
                                    string="Active users"
                                />
                                <div col="4">
                                    <field
                                        name="user_accounts_active"
                                        class="oe_inline"
                                        decoration-bf="1"
                                    />
                                    <span>/</span>
                                    <field
                                        name="user_accounts_active_max"
                                        class="oe_inline"
                                        decoration-warning="user_accounts_active &gt;= user_accounts_active_max"
                                    />
                                </div>
                                <field
                                    name="user_accounts_active_percent"
                                    widget="progressbar"
                                    options="{'max_value': 100, 'style': 'success'}"
                                />

                                <label for="user_accounts_active_interval" />
                                <div col="4">
                                    <field
                                        name="user_accounts_active_interval"
                                        nolabel="1"
                                        class="oe_inline"
                                    />
                                    <span>/</span>
                                    <field
                                        name="user_accounts_active_type"
                                        nolabel="1"
                                        class="oe_inline"
                                    />
                                </div>

                                <label for="user_accounts_total" string="Total users" />
                                <div col="4">
                                    <field
                                        name="user_accounts_total"
                                        class="oe_inline"
                                        decoration-bf="1"
                                    />
                                    <span>/</span>
                                    <field
                                        name="user_accounts_total_max"
                                        class="oe_inline"
                                        decoration-warning="user_accounts_total &gt;= user_accounts_total_max"
                                    />
                                </div>
                                <field
                                    name="user_accounts_total_percent"
                                    widget="progressbar"
                                    options="{'max_value': 100, 'style': 'success'}"
                                />
                            </group>

                            <group name="usage_group_usage" string="Usage">
                                <label for="disk_usage" string="Disk usage" />
                                <div col="4">
                                    <field
                                        name="disk_usage"
                                        class="oe_inline"
                                        decoration-bf="1"
                                    />
                                    <span class="oe_inline">/</span>
                                    <field
                                        name="disk_usage_max"
                                        class="oe_inline"
                                        decoration-warning="disk_usage &gt;= disk_usage_max"
                                    />
                                    <span class="oe_inline"> GB</span>
                                </div>
                                <field
                                    name="disk_usage_percent"
                                    widget="progressbar"
                                    options="{'max_value': 100, 'style': 'success'}"
                                />
                            </group>
                        </page>
                        <page name="components" string="External components">
                            <field name="external_component_ids" />
                        </page>
                        <page name="projects" string="Projects">
                            <field name="project_ids" />
                        </page>
                        <page name="info" string="Additional info">
                            <field name="additional_info" />
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
</odoo>
