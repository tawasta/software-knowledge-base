<?xml version="1.0" ?>
<odoo>
    <!-- Installations Form View -->
    <record model="ir.ui.view" id="installation_form_view">
        <field name="name">installation.form.view</field>
        <field name="model">software_knowledge_base.installation</field>
        <field name="arch" type="xml">
            <form string="Installations">
                <header>
                    <field name="state" widget="statusbar" clickable="1" />
                </header>
                <sheet string="Form">
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_modules"
                            icon="fa-puzzle-piece"
                        >
                            <field
                                string="Modules"
                                name="module_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <field name="platform_image" widget="image" class="oe_avatar" />
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="platform_id" />
                            <field name="identifier" />
                            <field name="company_id" />
                            <label for="user_accounts_active" string="Active users" />
                            <div col="4">
                                <field
                                    name="user_accounts_active_min"
                                    class="oe_inline oe_edit_only"
                                    decoration-warning="user_accounts_active &lt;= user_accounts_active_min"
                                />
                                <span class="oe_edit_only">/</span>
                                <field
                                    name="user_accounts_active"
                                    class="oe_inline"
                                    decoration-bf="1"
                                />
                                <span class="">/</span>
                                <field
                                    name="user_accounts_active_max"
                                    class="oe_inline"
                                    decoration-warning="user_accounts_active &gt;= user_accounts_active_max"
                                />
                            </div>
                            <field
                                name="user_accounts_active_percent"
                                class="oe_read_only"
                                widget="progressbar"
                            />
                            <label for="user_accounts_active_interval" />
                            <div col="4">
                                <field
                                    name="user_accounts_active_interval"
                                    nolabel="1"
                                    class="oe_inline"
                                />
                                <span class="">/</span>
                                <field
                                    name="user_accounts_active_type"
                                    nolabel="1"
                                    class="oe_inline"
                                />
                            </div>
                            <label for="user_accounts_total" string="Total users" />
                            <div col="4">
                                <field
                                    name="user_accounts_total_min"
                                    class="oe_inline oe_edit_only"
                                    decoration-warning="user_accounts_total &lt;= user_accounts_total_min"
                                />
                                <span class="oe_edit_only">/</span>
                                <field
                                    name="user_accounts_total"
                                    class="oe_inline"
                                    decoration-bf="1"
                                />
                                <span class="">/</span>
                                <field
                                    name="user_accounts_total_max"
                                    class="oe_inline"
                                    decoration-warning="user_accounts_total &gt;= user_accounts_total_max"
                                />
                            </div>
                            <field
                                name="user_accounts_total_percent"
                                class="oe_read_only"
                                widget="progressbar"
                            />
                            <label for="disk_usage" string="Disk usage" />
                            <div col="4">
                                <field
                                    name="disk_usage_min"
                                    class="oe_inline oe_edit_only"
                                    decoration-warning="disk_usage &lt;= disk_usage_min"
                                />
                                <span class="oe_edit_only">/</span>
                                <field
                                    name="disk_usage"
                                    decoration-bf="1"
                                    class="oe_inline"
                                />
                                <span class="">/</span>
                                <field
                                    name="disk_usage_max"
                                    class="oe_inline"
                                    decoration-warning="disk_usage &gt;= disk_usage_max"
                                />
                                <span class=""> GB </span>
                            </div>
                            <field
                                name="disk_usage_percent"
                                class="oe_read_only"
                                widget="progressbar"
                            />
                        </group>
                        <group>
                            <field name="type" />
                            <field name="url" widget="url" />
                            <field name="server_id" />
                            <field name="server_ip_address" readonly="1" />
                            <field name="port" />
                            <field name="db_server_id" />
                            <field name="db_server_ip_address" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="customers" string="Customers">
                            <field name="partner_ids" />
                        </page>
                        <page name="modules" string="Modules">
                            <field name="module_ids" />
                        </page>
                        <page name="components" string="External components">
                            <field name="external_component_ids" />
                        </page>
                        <page name="projects" string="Projects">
                            <field name="project_ids" />
                        </page>
                        <page name="info" string="Additional info">
                            <field name="additional_info" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
</odoo>
