<?xml version="1.0" ?>
<odoo>
    <!-- Server search view -->
    <record model="ir.ui.view" id="server_search_view">
        <field name="name">server.search.view</field>
        <field name="model">software_knowledge_base.server</field>
        <field name="arch" type="xml">
            <search string="Search servers">
                <field name="name" />
                <field name="server_type" />
                <field name="company_id" />
                <field name="ip_address" />
                <field name="operating_system_id" />
                <group expand="0" string="State">
                    <filter
                        string="Active"
                        name="active"
                        domain="[('active', '=', True)]"
                    />
                    <filter
                        string="Inactive"
                        name="invactive"
                        domain="[('active', '=', False)]"
                    />
                </group>
                <group expand="0" string="Group By">
                    <filter
                        string="Company"
                        name="company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        string="Supplier"
                        name="supplier"
                        context="{'group_by': 'supplier_id'}"
                    />
                    <filter
                        string="OS"
                        name="os"
                        context="{'group_by': 'operating_system_id'}"
                    />
                    <filter
                        string="Server type"
                        name="server_type"
                        context="{'group_by': 'server_type'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
