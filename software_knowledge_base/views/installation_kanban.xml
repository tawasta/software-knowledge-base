<?xml version="1.0" ?>
<odoo>
    <!-- Installations Tree View -->
    <record model="ir.ui.view" id="installation_kanban_view">
        <field name="name">Installation kanban</field>
        <field name="model">software_knowledge_base.installation</field>
        <field name="arch" type="xml">

            <kanban sample="1">
                <field name="id" />
                <field name="name" />
                <field name="state" />
                <field name="platform_id" />
                <field name="server_id" />
                <field name="server_ip_address" />
                <field name="platform_image" />
                <field name="disk_usage" />
                <field name="disk_usage_max" />
                <field name="user_accounts_active" />
                <field name="user_accounts_active_max" />

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="ribbon ribbon-top-right" invisible="active">
                                <span class="text-bg-danger">Archived</span>
                            </div>

                            <div class="o_kanban_content container">
                                <div class="row">
                                    <div class="col-8">
                                        <h4><strong><field name="name" /></strong></h4>
                                        <p>
                                            <field name="active" invisible="1" /><br />
                                            <strong><field
                                                    name="server_id"
                                                /></strong><br />
                                            <field name="server_ip_address" />
                                        </p>
                                        <p>
                                            <strong><field
                                                    name="db_server_id"
                                                /></strong><br />
                                            <field name="db_server_ip_address" />
                                        </p>
                                    </div>
                                    <div class="col-4">
                                        <field
                                            name="platform_image"
                                            widget="image"
                                            class="oe_avatar"
                                            options="{'style': 'height: 40px;'}"
                                        />
                                        <span><field
                                                name="state"
                                                widget="badge"
                                                decoration-success="state == 'ready'"
                                                decoration-info="state == 'setup'"
                                                decoration-danger="state == 'terminated'"
                                            />
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <field
                                        name="disk_usage"
                                        class="col-6"
                                        widget="gauge"
                                        options="{'max_field': 'disk_usage_max', 'style': 'width:120px; height: 120px;'}"
                                    />
                                        <field
                                        name="user_accounts_active"
                                        class="col-6"
                                        widget="gauge"
                                        options="{'max_field': 'user_accounts_active_max', 'style': 'width:120px; height: 120px;'}"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
