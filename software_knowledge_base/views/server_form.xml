<?xml version="1.0" ?>
<odoo>
    <!-- Server Form View -->
    <record model="ir.ui.view" id="server_form_view">
        <field name="name">server.form.view</field>
        <field name="model">software_knowledge_base.server</field>
        <field name="arch" type="xml">
            <form string="Servers">
                <header>
                </header>
                <sheet string="Form">
                    <div class="oe_button_box" name="button_box">

                    </div>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="company_id"
                                options="{'no_open': True, 'no_create': True }"
                            />
                            <field name="user_id" />
                            <field
                                name="supplier_id"
                                options="{'no_open': True, 'no_create': True }"
                            />
                        </group>
                        <group>
                            <field name="ip_address" />
                            <field name="operating_system_id" />
                            <field name="server_type" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Installations">
                            <field
                                name="installation_ids"
                                invisible="not installation_ids"/>
                            <field
                                name="db_installation_ids"
                                invisible="not db_installation_ids"/>
                        </page>
                        <page string="Technical specifications">
                            <group>
                                <field name="cpu_cores" />
                                <field name="ram" />
                                <field name="disk_size" />
                                <field
                                    name="disk_used"
                                    decoration-warning="disk_used &gt;= disk_size * 0.8"
                                />
                                <field name="disk_available" />
                                                            <field
                                    name="disk_usage_percent"
                                    class="oe_read_only"
                                    widget="progressbar"
                                />
                            </group>
                            <label for="specification" />
                            <field name="specification" />
                        </page>
                        <page string="Additional info">
                            <field name="additional_info" />
                        </page>
                        <page string="Notes">
                            <field name="note_ids" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
</odoo>
