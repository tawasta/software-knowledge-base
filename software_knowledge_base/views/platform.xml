<?xml version="1.0"?>
<openerp>
    <data>
	    <!-- Platforms Tree View -->
	    <record model="ir.ui.view" id="platform_tree_view">
	        <field name="name">SW Knowledge Base - Platforms tree</field>
	        <field name="model">software_knowledge_base.platform</field>
	        <field name="arch" type="xml">
	            <tree string="Platforms">
	                <field name="name"/>
					<field name="description"/>
					<field name="repository"/>
	            </tree>
	        </field>
	    </record>

	    <!-- Platforms Form View -->
	    <record model="ir.ui.view" id="platform_form_view">
	        <field name="name">SW Knowledge Base - Platforms form</field>
	        <field name="model">software_knowledge_base.platform</field>
	        <field name="arch" type="xml">
	            <form string="Platforms">
	                <header>
	                </header>
	                <sheet string="Form">
	                    <div class="oe_title">
	                        <div class="oe_edit_only">
	                            <label for="name"/>
	                        </div>
	                        <h1><field name="name" required="1"/></h1>
	                    </div>
	
						<group>
							<field name="description" />
							<field name="repository" />
							<field name="active" />
						</group>

	                </sheet>
	                <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
	            </form>
	        </field>
	    </record>

    </data>
</openerp>
