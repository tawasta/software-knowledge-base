<?xml version="1.0" ?>
<odoo>
    <!-- Platforms Tree View -->
    <record model="ir.ui.view" id="platform_tree_view">
        <field name="name">platform.tree.view</field>
        <field name="model">software_knowledge_base.platform</field>
        <field name="arch" type="xml">
            <tree string="Platforms">
                <field name="name" />
                <field name="description" optional="show" />
                <field name="installation_ids" optional="show" />
            </tree>
        </field>
    </record>
    <!-- Platforms Form View -->
    <record model="ir.ui.view" id="platform_form_view">
        <field name="name">platform.form.view</field>
        <field name="model">software_knowledge_base.platform</field>
        <field name="arch" type="xml">
            <form string="Platforms">
                <div class="oe_button_box" name="button_box">

                </div>
                <header>

                </header>
                <sheet string="Form">
                    <field name="image" widget="image" class="oe_avatar" />
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <label for="description" />
                        <field name="description" nolabel="1" />
                    </group>
                    <field name="installation_ids" />
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
</odoo>
