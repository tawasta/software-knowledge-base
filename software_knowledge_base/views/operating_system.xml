<?xml version="1.0" ?>
<odoo>
    <!-- Operating system Tree View -->
    <record model="ir.ui.view" id="operating_system_tree_view">
        <field name="name">operating.system.tree.view</field>
        <field name="model">software_knowledge_base.operating_system</field>
        <field name="arch" type="xml">
            <tree string="Operating systems">
                <field name="name" string="Name" />
                <field name="server_ids" optional="show" />
            </tree>
        </field>
    </record>
    <!-- Operating system Form View -->
    <record model="ir.ui.view" id="operating_system_form_view">
        <field name="name">operating.system.form.view</field>
        <field name="model">software_knowledge_base.operating_system</field>
        <field name="arch" type="xml">
            <form string="Operating systems">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="toggle_active"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-archive"
                    >
                        <field
                            name="active"
                            widget="boolean_button"
                            options="{&quot;terminology&quot;: &quot;archive&quot;}"
                        />
                    </button>
                </div>
                <header>
                </header>
                <sheet string="Form">
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <field name="version" />
                        <field name="codename" />
                        <field name="url" widget="url" />
                        <field name="description" />
                    </group>
                    <field name="server_ids" />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
