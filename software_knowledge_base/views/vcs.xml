<?xml version="1.0"?>
<odoo>

	<!-- VCS Tree View -->
	<record model="ir.ui.view" id="vcs_tree_view">
		<field name="name">SW Knowledge Base - VCS tree</field>
		<field name="model">software_knowledge_base.vcs</field>
		<field name="arch" type="xml">
			<tree string="VCS">
				<field name="name"/>
				<field name="description"/>
			</tree>
		</field>
	</record>

	<!-- VCS Form View -->
	<record model="ir.ui.view" id="vcs_form_view">
		<field name="name">SW Knowledge Base - VCS form</field>
		<field name="model">software_knowledge_base.vcs</field>
		<field name="arch" type="xml">
			<form string="VCS">
				<header>
				</header>
				<sheet string="Form">
					<div class="oe_title">
						<div class="oe_edit_only">
							<label for="name"/>
						</div>
						<h1><field name="name" required="1"/></h1>
					</div>

					<separator string="Description"/>
					<field name="description" nolabel="1"/>
					<field name="vcs_hosts"/>

				</sheet>
			</form>
		</field>
	</record>

</odoo>
