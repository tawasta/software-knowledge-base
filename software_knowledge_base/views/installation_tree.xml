<?xml version="1.0" ?>
<odoo>
    <!-- Installations Tree View -->
    <record model="ir.ui.view" id="installation_tree_view">
        <field name="name">installation.tree.view</field>
        <field name="model">software_knowledge_base.installation</field>
        <field name="arch" type="xml">
            <tree
                string="Installations"
                decoration-muted="state=='terminated'"
                decoration-info="state=='setup'"
            >
                <field name="name" />
                <field name="partner_ids" optional="show" />
                <field name="platform_id" optional="show" />
                <field
                    name="user_accounts_active_percent"
                    widget="progressbar"
                    optional="show"
                />
                <field name="disk_usage_percent" widget="progressbar" optional="show" />
                <field name="server_id" optional="show" />
                <field name="server_ip_address" optional="show" />
                <field name="type" optional="show" />
                <field name="state" optional="show" />
                <field name="company_id" optional="show" />
            </tree>
        </field>
    </record>
</odoo>
