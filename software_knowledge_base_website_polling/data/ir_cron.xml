<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record forcecreate="True" id="ir_cron_swkb_website_poll" model="ir.cron">
        <field name="name">SWKB website poll</field>
        <field name="model_id" ref="model_installation"/>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">17</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall"/>
        <field eval="'cron_url_poll'" name="function"/>
    </record>
    <record id="channel_installation" model="queue.job.channel">
        <field name="name">installation</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
    </record>
    <record id="job_function_action_get_website_status" model="queue.job.function">
        <field name="model_id" ref="software_knowledge_base_website_polling.model_installation"/>
        <field name="method">action_get_website_status</field>
        <field name="channel_id" ref="channel_installation"/>
        <field name="retry_pattern" eval="{1: 60, 2: 180, 3: 10, 5: 300}"/>
    </record>
</odoo>
