<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="installation_form_view" model="ir.ui.view">
        <field name="name">installation_form_view_website_poll</field>
        <field name="model">software_knowledge_base.installation</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="inherit_id" ref="software_knowledge_base.installation_form_view" />
        <field name="arch" type="xml">

            <field name="url" position="after">
                <field name="url_poll" groups="software_knowledge_base.admin"/>
            </field>

            <xpath expr="//page[last()]" position="after">
                <page name="url_polls" string="URL polls"
                        attrs="{'invisible':[('url_poll', '=', False)]}"
                        groups="software_knowledge_base.admin">

                    <field name="installation_poll_ids">
                        <tree delete="false" create="false">
                            <field name="create_date" />
                            <field name="name" />
                            <field name="status_code" />
                            <field name="title" />
                            <field name="delay" avg='Avg delay'/>
                            <field name="success" />
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>