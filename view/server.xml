<?xml version="1.0"?>
<openerp>
    <data>
	    <!-- Servers Tree View -->
	    <record model="ir.ui.view" id="server_tree_view">
	        <field name="name">SW Knowledge Base - Servers tree</field>
	        <field name="model">software_knowledge_base.server</field>
	        <field name="arch" type="xml">
	            <tree string="Servers">
	                <field name="name"/>
					<field name="ip_address"/>
					<field name="operating_system"/>
					<field name="installation_ids"/>
					<field name="company_id"/>
	            </tree>
	        </field>
	    </record>

	    <!-- Servers Form View -->
	    <record model="ir.ui.view" id="server_form_view">
	        <field name="name">SW Knowledge Base - Servers form</field>
	        <field name="model">software_knowledge_base.server</field>
	        <field name="arch" type="xml">
	            <form string="Servers">
	                <header>
	                </header>
	                <sheet string="Form">
	                    <div class="oe_title">
	                        <div class="oe_edit_only">
	                            <label for="name"/>
	                        </div>
	                        <h1><field name="name" required="1"/></h1>
	                    </div>
	
	                    <group col="4">	              
							<field name="company_id" widget="selection"/>          
							<field name="ip_address"/>
							<field name="operating_system"/>
	                    </group>

						<notebook>
							<page string="Installations">
								<field name="installation_ids"/>
							</page>
							<page string="Technical specifications">
								<field name="specification"/>
							</page>
							<page string="Additional info">
								<field name="additional_info"/>
							</page>

						</notebook>
	                </sheet>
	                <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
	            </form>
	        </field>
	    </record>

    </data>
</openerp>
