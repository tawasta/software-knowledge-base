<?xml version="1.0"?>
<openerp>
    <data>
	    <!-- VCS Provider Tree View -->
	    <record model="ir.ui.view" id="vcs_provider_tree_view">
	        <field name="name">SW Knowledge Base - VCS Provider tree</field>
	        <field name="model">software_knowledge_base.vcs_provider</field>
	        <field name="arch" type="xml">
	            <tree string="VCS Providers">
	                <field name="name"/>
					<field name="address"/>
	            </tree>
	        </field>
	    </record>

	    <!-- VCS Host Form View -->
	    <record model="ir.ui.view" id="vcs_provider_form_view">
	        <field name="name">SW Knowledge Base - VCS Provider form</field>
	        <field name="model">software_knowledge_base.vcs_provider</field>
	        <field name="arch" type="xml">
	            <form string="VCS Providers">
	                <sheet string="Form">
	                    <div class="oe_title">
	                        <div class="oe_edit_only">
	                            <label for="name"/>
	                        </div>
	                        <h1><field name="name" required="1"/></h1>
	                    </div>
	
						<group col='3'>
							<field name="address"/><group/>
						</group>

	                </sheet>
	            </form>
	        </field>
	    </record>

    </data>
</openerp>
