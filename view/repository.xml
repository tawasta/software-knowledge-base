<?xml version="1.0"?>
<openerp>
    <data>
	    <!-- Repository Tree View -->
	    <record model="ir.ui.view" id="repository_tree_view">
	        <field name="name">SW Knowledge Base - Repositories tree</field>
	        <field name="model">software_knowledge_base.platform</field>
	        <field name="arch" type="xml">
	            <tree string="Repositories">
	                <field name="name"/>
					<field name="description"/>
	            </tree>
	        </field>
	    </record>

	    <!-- Repository Form View -->
	    <record model="ir.ui.view" id="repository_form_view">
	        <field name="name">SW Knowledge Base - Repositories form</field>
	        <field name="model">software_knowledge_base.repository</field>
	        <field name="arch" type="xml">
	            <form string="Repositories">
	                <header>
	                </header>
	                <sheet string="Form">
	                    <div class="oe_title">
	                        <h1><field name="name" required="1" placeholder='Repository name'/></h1>
	                    </div>
	
						<group>
							<field name="description" style='width: 50%;'/>
							<field name="vcs_host_id" style='width: 50%;'/>
							<field name="team" style='width: 50%;'/>
							<field name="url" style='width: 50%;'/>
						</group>

	                </sheet>
	                <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
	            </form>
	        </field>
	    </record>

    </data>
</openerp>
