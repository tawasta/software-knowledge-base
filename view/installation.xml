<?xml version="1.0"?>
<openerp>
    <data>
	    <!-- Installations Tree View -->
	    <record model="ir.ui.view" id="installation_tree_view">
	        <field name="name">SW Knowledge Base - Installations tree</field>
	        <field name="model">software_knowledge_base.installation</field>
	        <field name="arch" type="xml">
	            <tree string="Installations">
	                <field name="name"/>
					<field name="partner_id"/>
					<field name="project_ids"/>
					<field name="platform_id"/>
					<field name="server_id"/>
					<field name="port"/>
					<field name="db_server_id"/>
					<field name="state"/>
					<field name="company_id"/>
	            </tree>
	        </field>
	    </record>

	    <!-- Installations Form View -->
	    <record model="ir.ui.view" id="installation_form_view">
	        <field name="name">SW Knowledge Base - Installations form</field>
	        <field name="model">software_knowledge_base.installation</field>
	        <field name="arch" type="xml">
	            <form string="Installations">
	                <header>
						<field name="state" widget="statusbar" clickable="1"/>
	                </header>
	                <sheet string="Form">
	                    <div class="oe_title">
	                        <div class="oe_edit_only">
	                            <label for="name"/>
	                        </div>
	                        <h1><field name="name" required="1"/></h1>
	                    </div>
	
	                    <group col="4">
							<field name="partner_id"/>
							<field name="platform_id"/>
							<field name="server_id"/>
							<field name="port"/>
							<field name="db_server_id"/>
							<field name="disk_usage"/>
							<field name="company_id" widget="selection"/>
	                    </group>


						<notebook>
							<page string="Modules">
								<field name="module_ids"/>
							</page>
							<page string="External components">
								<field name="external_component_ids"/>
							</page>
							<page string="Projects">
								<field name="project_ids"/>
							</page>
							<page string="Additional info">
								<field name="additional_info"/>
							</page>

						</notebook>
	                </sheet>
	                <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
	            </form>
	        </field>
	    </record>

    </data>
</openerp>
