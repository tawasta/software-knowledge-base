<?xml version="1.0"?>
<openerp>
    <data>
	    <!-- VCS Team Tree View -->
	    <record model="ir.ui.view" id="vcs_team_tree_view">
	        <field name="name">SW Knowledge Base - VCS Team tree</field>
	        <field name="model">software_knowledge_base.vcs_team</field>
	        <field name="arch" type="xml">
	            <tree string="Teams">
	                <field name="name"/>
	                <field name="description"/>
	            </tree>
	        </field>
	    </record>

	    <!-- VCS Team Form View -->
	    <record model="ir.ui.view" id="vcs_host_form_view">
	        <field name="name">SW Knowledge Base - VCS Team form</field>
	        <field name="model">software_knowledge_base.vcs_team</field>
	        <field name="arch" type="xml">
	            <form string="Teams">
	                <header>
	                </header>
	                <sheet string="Form">
	                    <div class="oe_title">
	                        <div class="oe_edit_only">
	                            <label for="name"/>
	                        </div>
	                        <h1><field name="name" required="1"/></h1>
	                    </div>
	
						<group col='3'>
							<field name="address"/><group/>
							<field name="description"/><group/>
						</group>

	                </sheet>
	            </form>
	        </field>
	    </record>

    </data>
</openerp>
