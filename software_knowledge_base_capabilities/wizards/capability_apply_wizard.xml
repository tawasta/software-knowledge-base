<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="swkb_capability_apply_wizard_view" model="ir.ui.view">
    <field name="name">swkb.capability.apply.wizard.form</field>
    <field name="model">swkb.capability.apply.wizard</field>
    <field name="arch" type="xml">
      <form string="Apply Capabilities">
        <group>
          <field name="installation_id" readonly="1" />
        </group>
        <field name="line_ids" context="{'default_wizard_id': active_id}">
          <tree editable="bottom">
            <field name="apply" />
            <field name="capability_id" />
            <field name="module_ids" widget="many2many_tags" readonly="1" />
          </tree>
        </field>
        <footer>
          <button
                        string="Apply"
                        type="object"
                        name="action_apply"
                        class="btn-primary"
                    />
          <button string="Cancel" special="cancel" class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
