<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <!-- Tree -->
  <record id="swkb_capability_view_tree" model="ir.ui.view">
    <field name="name">swkb.capability.tree</field>
    <field name="model">swkb.capability</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="active" />
      </tree>
    </field>
  </record>

  <!-- Form -->
  <record id="swkb_capability_view_form" model="ir.ui.view">
    <field name="name">swkb.capability.form</field>
    <field name="model">swkb.capability</field>
    <field name="arch" type="xml">
      <form string="Capability">
        <sheet>
          <group>
            <field name="name" />
            <field name="active" />
          </group>
          <group>
            <field name="description" />
          </group>
          <group string="Technical Notes">
            <field name="technical_notes" />
          </group>
          <notebook>
            <page string="Module Requirements">
              <field name="requirement_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle" />
                  <field name="module_id" />
                  <field name="required" />
                  <field name="note" />
                </tree>
                <form>
                  <group>
                    <field name="module_id" />
                    <field name="required" />
                    <field name="sequence" />
                    <field name="note" />
                  </group>
                </form>
              </field>
            </page>

            <page string="Included Capabilities">
              <field
                                name="child_capability_ids"
                                widget="many2many_tags"
                                domain="[('id','!=', active_id)]"
                            />
            </page>

            <page string="Resolved Modules (incl. included)">
              <field name="resolved_module_ids" widget="many2many_tags" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="swkb_capability_action" model="ir.actions.act_window">
    <field name="name">Capabilities</field>
    <field name="res_model">swkb.capability</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="swkb_capability_view_tree" />
  </record>

  <!-- Menu -->
  <menuitem
        id="menu_swkb_capabilities_root"
        name="Capabilities"
        parent="software_knowledge_base.root_menu"
        sequence="40"
    />
  <menuitem
        id="menu_swkb_capabilities_manage"
        name="Manage"
        parent="menu_swkb_capabilities_root"
        action="swkb_capability_action"
        sequence="10"
    />
</odoo>
