<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="installation_form_inherit_capabilities" model="ir.ui.view">
    <field name="name">software_knowledge_base.installation.form.capabilities</field>
    <field name="model">software_knowledge_base.installation</field>
    <field name="inherit_id" ref="software_knowledge_base.installation_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Capabilities">
          <group>
            <field
                            name="capability_line_ids"
                            context="{'default_installation_id': active_id}"
                        >
              <tree editable="bottom">
                <field name="capability_id" />
                <field name="status" readonly="1" />
              </tree>
            </field>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
